diff --git a/CSVM/src/UI/Boards/BoardArtSizes.cs b/CSVM/src/UI/Boards/BoardArtSizes.cs
new file mode 100644
index 00000000..93b349ba
--- /dev/null
+++ b/CSVM/src/UI/Boards/BoardArtSizes.cs
@@ -0,0 +1,80 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Text.Json;
+using CSVM.Utils;
+
+namespace CSVM.UI.Boards;
+
+/// <summary>
+/// Manifest of authored art dimensions on the 800x600 coordinate plane, loaded from
+/// art_sizes.json so high-resolution textures do not inflate layout boxes or spans.
+/// </summary>
+public sealed class BoardArtSizes
+{
+    private readonly Dictionary<string, (int Width, int Height)> _manifest = new(StringComparer.OrdinalIgnoreCase);
+    private readonly string _dataRoot;
+
+    public BoardArtSizes(string dataRoot)
+    {
+        _dataRoot = dataRoot ?? throw new ArgumentNullException(nameof(dataRoot));
+        LoadManifest();
+    }
+
+    /// <summary>The authored pixel size of the art, or null if unmanifested.</summary>
+    public (int Width, int Height)? Measure(string art)
+    {
+        if (string.IsNullOrEmpty(art))
+        {
+            return null;
+        }
+
+        string baseName = Path.GetFileName(art);
+        if (_manifest.TryGetValue(baseName, out var authored)
+            || _manifest.TryGetValue(art, out authored))
+        {
+            return authored;
+        }
+
+        return null;
+    }
+
+    private void LoadManifest()
+    {
+        string[] candidates =
+        {
+            Path.Combine(_dataRoot, "extracted", "rof", "art_sizes.json"),
+            Path.Combine(_dataRoot, "extracted", "art_sizes.json"),
+            Path.Combine(_dataRoot, "art_sizes.json"),
+        };
+
+        foreach (var path in candidates)
+        {
+            if (!File.Exists(path))
+            {
+                continue;
+            }
+
+            try
+            {
+                using var doc = JsonDocument.Parse(File.ReadAllText(path));
+                foreach (var prop in doc.RootElement.EnumerateObject())
+                {
+                    if (prop.Value.ValueKind == JsonValueKind.Array
+                        && prop.Value.GetArrayLength() == 2)
+                    {
+                        int w = prop.Value[0].GetInt32();
+                        int h = prop.Value[1].GetInt32();
+                        _manifest[prop.Name] = (w, h);
+                    }
+                }
+
+                break;
+            }
+            catch (Exception ex)
+            {
+                Log.Info("ui", $"art manifest at {path} did not parse ({ex.Message})");
+            }
+        }
+    }
+}
